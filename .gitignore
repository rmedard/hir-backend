# Drupal Files and Directories
/public_html/sites/*/settings*.php
!/public_html/sites/*/settings.php
/public_html/sites/*/services*.yml
!/public_html/sites/*/services.yml
/public_html/sites/*/files
/public_html/sites/*/private
/public_html/sites/default/default.settings.php
/public_html/sites/default/default.services.yml
/public_html/libraries

# Ignore sensitive configuration
/public_html/sites/*/settings.local.php
/public_html/sites/*/settings.ddev.php

# Files directory
/public_html/sites/default/files/
/public_html/sites/*/files/

# Private files
/private/

# Temporary files
/tmp/
/public_html/sites/*/tmp/

# Drupal Core
/public_html/core/
/public_html/vendor/
/public_html/autoload.php

# Dependencies
/vendor/
/node_modules/

# DDEV
/.ddev/*
!/.ddev/config.yaml

# Database dumps
*.sql
*.sql.gz
database-backup.sql.gz

# Environment-specific files
.env
.env.local

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
*.log
/logs/
/public_html/sites/*/logs/

# Cache directories
/public_html/sites/default/files/css/
/public_html/sites/default/files/js/
/public_html/sites/default/files/styles/
/public_html/sites/default/files/config_*/

# Configuration management (keep in separate directory)
# Only ignore if config is in sites/default/files/sync
/public_html/sites/default/files/sync/

# Backup files
*.bak
*.backup
*.orig

# OS generated files
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# Node.js (if using for front-end build)
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Drupal console
/.console/
